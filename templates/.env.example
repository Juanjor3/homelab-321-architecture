# Local fast backup staging directory
BACKUP_LOCAL_DIR=/mnt/backup_local

# Secondary local NAS mount directory
NAS_MOUNT_DIR=/mnt/nas_backups

# Rclone encrypted remote target (e.g. gdrive_crypt:/server_backups)
RCLONE_REMOTE=cloud_crypt:/server_backups

# Minimum free space (in MB) required before creating archives
MIN_FREE_MB=5120

# Retention days for local tarballs
RETENTION_DAYS=7

# Example PostgreSQL container & database for dump
PG_CONTAINER=app_postgres
PG_USER=postgres
PG_DB=app_db
